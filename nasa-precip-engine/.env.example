# NASA Earthdata credentials
# Register at: https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=your_username_here
EARTHDATA_PASSWORD=your_password_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001

# Logging
LOG_LEVEL=INFO

# Optional persistent cache for completed real-evidence windows
IMERG_CACHE_DIR=
IMERG_DISK_CACHE_TTL_SECONDS=2592000

# Optional root npm run dev overrides
GEOLENS_PYTHON=
GEOLENS_TEMP_DIR=
