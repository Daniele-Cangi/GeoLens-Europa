    },
    {
      "path": "../../packages/providers"
    },
    {
      "path": "../../packages/stormwater"
    },
    {
      "path": "../../packages/proof-zero"
    }
  ],
  "include": [
    "src/index.ts",
    "src/refoundation/**/*.ts"
  ]
